'pancreatic-ct': [
 label(150, 30, 'split by slice'), label(450, 30, 'split by patient'),
 draw(box(20, 46, 260, 92)), draw(box(320, 46, 260, 92)),
 label(36, 68, 'train', 'mono', 'start'), label(336, 68, 'train', 'mono', 'start'),
