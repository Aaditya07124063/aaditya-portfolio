---
import {icon, draw, tint, flow, link, label, box, jag, sine} from '../sketch';
const {kind = 'resqnet', label: aria} = Astro.props;
const slices = (x: number, y: number, who: string) => [...who].map((c, n) => {
 const d = `M${x + n * 34} ${y}c7-1.5 15-1.5 22 0 1.4 7 1.4 15 0 22-7 1.4-15 1.4-22 0-1.4-7-1.4-15 0-22z`;
 return (c === 'a' ? tint(d) : `<path class="hatch" d="${d}"/>`) + draw(d);
}).join('');
const art: Record<string, string> = {
