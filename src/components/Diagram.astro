 label(502, 222, 'new id?'), label(502, 244, 'store + forward', 'hot'),
 label(30, 345, 'ttl', 'mono', 'start'),
 ...Array.from({length: 10}, (_, n) => (n < 7 ? tint(box(70 + n * 28, 330, 20, 20)) : '') + draw(box(70 + n * 28, 330, 20, 20))),
