};
---
<figure class={`sketch sketch-${kind}`} role="img" aria-label={aria ?? `Diagram for ${kind}`}><svg viewBox="0 0 600 380" class="sk" aria-hidden="true"><g class="art" set:html={art[kind]} /></svg></figure>
