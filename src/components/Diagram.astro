 draw(box(20, 156, 260, 92)), draw(box(320, 156, 260, 92)),
 label(36, 178, 'test', 'mono', 'start'), label(336, 178, 'test', 'mono', 'start'),
 slices(38, 194, 'babab'), slices(338, 194, 'bbbbb'),
 draw('M118 268c10 10 20 20 30 30', 'hot-ink'), draw('M148 268c-10 10-20 20-30 30', 'hot-ink'),
 label(150, 326, 'same person on both sides'),
