 '<path class="hatch" d="M170 346c5-1 11-1 16 0 1 5 1 11 0 16-5 1-11 1-16 0-1-5-1-11 0-16z"/>', draw('M170 346c5-1 11-1 16 0 1 5 1 11 0 16-5 1-11 1-16 0-1-5-1-11 0-16z'), label(194, 360, 'patient B', 'mono', 'start'),
 label(580, 360, 'MD5 drops exact duplicates', 'mono', 'end')
